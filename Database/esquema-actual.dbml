// PostgreSQL: esquema físico versión 5. Once tablas de dominio y una técnica.
// Los códigos cerrados se implementan con CHECK sobre TEXT, sin tipos enum nativos.
Project DecibelCity {
  database_type: 'PostgreSQL'
}
Table departamentos {
  id_departamento integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  ubigeo text [not null, unique, note: 'Dos dígitos ASCII; se conserva como texto.']
  nombre_departamento text [not null, unique, note: 'Nombre no vacío.']
  activo boolean [not null, default: true, note: 'Desactivar no borra ni modifica a sus hijos.']
}

Table provincias {
  id_provincia integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  id_departamento integer [not null]
  ubigeo text [not null, unique, note: 'Cuatro dígitos ASCII.']
  nombre_provincia text [not null, note: 'Nombre no vacío.']
  activo boolean [not null, default: true, note: 'La disponibilidad para registro considera también al departamento.']

  indexes {
    (id_departamento, nombre_provincia) [unique]
  }
}

Table distritos {
  id_distrito integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  id_provincia integer [not null]
  ubigeo text [not null, unique, note: 'Seis dígitos ASCII.']
  nombre_distrito text [not null, note: 'Nombre no vacío.']
  activo boolean [not null, default: true, note: 'La disponibilidad para registro considera también a sus padres.']

  indexes {
    (id_provincia, nombre_distrito) [unique]
  }
}

Table zonificaciones {
  id_zonificacion integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  codigo text [not null, unique, note: 'Código no vacío.']
  nombre text [not null, note: 'Nombre no vacío.']
  descripcion text [not null, note: 'Descripción no vacía. No incluye límites acústicos normativos.']
}

Table categorias_fuente_ruido {
  id_categoria integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  codigo text [not null, unique, note: 'Código no vacío; agrupación propia de la aplicación.']
  nombre text [not null, note: 'Nombre no vacío.']
  descripcion text [not null, note: 'Descripción no vacía.']
}

Table roles_usuario {
  id_rol integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  nombre_rol text [not null, unique, note: 'Nombre no vacío.']
  descripcion text [not null, note: 'Descripción no vacía.']
  activo boolean [not null, default: true, note: 'Rol base «ciudadano» asegurado al iniciar (ON CONFLICT DO NOTHING); no se reactiva. Sin permisos operativos implementados.']
}

Table tipos_fuente_ruido {
  id_tipo_fuente integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  codigo text [not null, unique, note: 'CHECK: traffic, commerce, construction, entertainment u other.']
  nombre_fuente text [not null, note: 'Etiqueta no vacía; se conserva si se personaliza.']
  id_categoria integer [not null]
}

Table estados_reporte {
  id_estado integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  codigo_estado text [not null, unique, note: 'CHECK: received.']
  descripcion text [not null, note: 'Descripción no vacía.']
}

Table reportes_ciudadanos {
  id_reporte text [pk, not null, note: 'UUID en reportes nuevos; conserva el identificador histórico. No vacío.']
  id_tipo_fuente integer [not null]
  id_estado integer [not null]
  descripcion text [not null, note: 'Entre 10 y 500 caracteres.']
  nivel_estimado_db "double precision" [note: 'Opcional; entre 30 y 120. Estimación ciudadana, sin certificación acústica.']
  fecha_hora timestamptz [not null, note: 'Instante con zona horaria; conexiones en UTC.']
  id_lugar text [note: 'Identificador del lugar verificado en servidor. OpenStreetMap: N, W o R seguido del número (p. ej. W813046785).']
  proveedor_lugar text [note: "'osm' para reportes nuevos (Nominatim); 'google' para reportes anteriores a la versión 4."]
  es_historico boolean [not null, default: false, note: 'Conserva la marca de los registros históricos importados.']
  ubicacion_heredada text [note: 'Texto antiguo sin considerarlo una ubicación verificada.']

  Note: 'CHECK: un reporte no histórico debe tener id_lugar y ubicacion_heredada NULL; id_lugar y proveedor_lugar se informan juntos; con proveedor osm, id_lugar sigue el formato N/W/R + número. El reporte no guarda la dirección ni las coordenadas: se consultan con el identificador.'
}

Table puntos_criticos {
  id_punto text [pk, not null, note: 'Identificador no vacío; se conserva durante la migración.']
  id_tipo_fuente integer [not null]
  nombre text [not null]
  area text [not null]
  id_distrito integer
  distrito_heredado text [note: 'Etiqueta original cuando no existe una correspondencia exacta con el catálogo local.']
  id_zonificacion integer [note: 'Opcional. Los puntos se cargan sin clasificación asignada.']
  sector text [not null]
  nivel_db "double precision" [not null]
  etiqueta_fuente text [not null, note: 'Texto específico del punto, independiente de la etiqueta general de la fuente.']
  descripcion text [not null]
  franja_horaria text [not null]
  x "double precision" [not null, note: 'Entre 0 y 100; posición histórica de diseño, no longitud.']
  y "double precision" [not null, note: 'Entre 0 y 100; posición histórica de diseño, no latitud.']
  limite_referencia "double precision" [not null, note: 'Referencia ilustrativa; no certifica una infracción.']
  ilustrativo boolean [not null, default: true, note: 'Los puntos iniciales son ilustrativos.']
  latitud "double precision" [note: 'Posición aproximada tomada de OpenStreetMap (ODbL). NULL junto con longitud si no se conoce.']
  longitud "double precision" [note: 'Posición aproximada tomada de OpenStreetMap (ODbL). NULL junto con latitud si no se conoce.']

  Note: 'CHECK: exactamente uno de id_distrito y distrito_heredado debe estar informado. latitud y longitud se informan juntas. Los niveles de ruido de los puntos iniciales siguen siendo ilustrativos.'
}

Table usuarios {
  id_usuario integer [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  id_rol integer [not null, note: 'Rol activo «ciudadano» al registrarse.']
  id_distrito integer [not null, note: 'Única referencia territorial: provincia y departamento se obtienen a través del distrito.']
  nombres text [not null, note: 'CHECK: entre 2 y 80 caracteres sin espacios extremos.']
  apellidos text [not null, note: 'CHECK: entre 2 y 80 caracteres sin espacios extremos.']
  telefono text [not null, note: "CHECK: ^[0-9+() -]{6,20}$"]
  direccion text [not null, note: 'CHECK: entre 5 y 200 caracteres sin espacios extremos. Texto declarado; no es una ubicación verificada.']
  nombre_usuario text [not null, unique, note: "CHECK: ^[a-zA-Z0-9_.-]{3,40}$. Único también sin distinguir mayúsculas."]
  password_hash text [not null, note: 'Hash Argon2id (argon2-cffi). Nunca la contraseña ni se expone por HTTP.']
  activo boolean [not null, default: true, note: 'Una cuenta inactiva no puede iniciar sesión (403).']
  fecha_registro timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    `lower(nombre_usuario)` [unique, name: 'usuarios_nombre_usuario_minusculas_unico']
    id_rol [name: 'usuarios_id_rol_idx']
    id_distrito [name: 'usuarios_id_distrito_idx']
  }
}

Ref provincia_departamento {
  provincias.id_departamento > departamentos.id_departamento [delete: restrict, update: cascade]
}

Ref distrito_provincia {
  distritos.id_provincia > provincias.id_provincia [delete: restrict, update: cascade]
}

Ref categoria_fuente {
  tipos_fuente_ruido.id_categoria > categorias_fuente_ruido.id_categoria [delete: restrict, update: cascade]
}

Ref distrito_punto {
  puntos_criticos.id_distrito > distritos.id_distrito [delete: restrict, update: cascade]
}

Ref zonificacion_punto {
  puntos_criticos.id_zonificacion > zonificaciones.id_zonificacion [delete: restrict, update: cascade]
}

Ref fuente_reporte {
  reportes_ciudadanos.id_tipo_fuente > tipos_fuente_ruido.id_tipo_fuente [delete: restrict, update: cascade]
}

Ref estado_reporte {
  reportes_ciudadanos.id_estado > estados_reporte.id_estado [delete: restrict, update: cascade]
}

Ref rol_usuario {
  usuarios.id_rol > roles_usuario.id_rol [delete: restrict, update: cascade]
}

Ref distrito_usuario {
  usuarios.id_distrito > distritos.id_distrito [delete: restrict, update: cascade]
}

Ref fuente_punto {
  puntos_criticos.id_tipo_fuente > tipos_fuente_ruido.id_tipo_fuente [delete: restrict, update: cascade]
}

// Metadatos internos de persistencia; no forman parte de los catálogos públicos.
Table decibelcity_schema {
  singleton boolean [pk, default: true, note: 'CHECK TRUE: admite una sola fila.']
  version integer [not null, note: 'Versión positiva; valor actual 5 (cuentas de usuario). Una base v3 o v4 se actualiza al iniciar el backend.']
  applied_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}
