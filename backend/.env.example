# DecibelCity API (ASP.NET Core 10). Copiar como backend/.env (excluido de Git).
# Las variables de entorno reales tienen prioridad sobre este archivo.

# --- PostgreSQL (esquema v5) ---------------------------------------------------
# Sustituir CAMBIAR por la contraseña del rol decibelcitydaw (Database/crear-bases-decibelcitydaw.sql).
# Sin contraseña en la URL, Npgsql usa PGPASSWORD o %APPDATA%\postgresql\pgpass.conf.
DECIBELCITY_DATABASE_URL=postgresql://decibelcitydaw:CAMBIAR@127.0.0.1:5432/decibelcitydaw
DECIBELCITY_DATABASE_SCHEMA=public
# Crea/verifica el esquema v5 y siembra catálogos INEI al arrancar (idempotente).
# DECIBELCITY_DATABASE_INITIALIZE=true

# Base exclusiva de pruebas (debe terminar en _test). Las pruebas solo crean y eliminan
# esquemas test_<guid>. Sin esta variable, las pruebas de PostgreSQL se omiten.
DECIBELCITY_TEST_DATABASE_URL=postgresql://decibelcitydaw:CAMBIAR@127.0.0.1:5432/decibelcitydaw_test

# --- Navegador y proxy ----------------------------------------------------------
# Orígenes separados por coma, sin barra final. "*" no está permitido (cookies con credenciales).
DECIBELCITY_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# IP o redes CIDR de proxies de confianza para X-Forwarded-For/Proto (Cloudflare, Nginx).
# Vacío: solo se confía en el bucle local. Ejemplo: 173.245.48.0/20,103.21.244.0/22
# DECIBELCITY_TRUSTED_PROXIES=

# --- OpenStreetMap (sin claves) -------------------------------------------------
# Solo cambiarlas para usar servidores propios. No reducir el intervalo con los públicos.
# DECIBELCITY_NOMINATIM_URL=https://nominatim.openstreetmap.org
# DECIBELCITY_PHOTON_URL=https://photon.komoot.io
# DECIBELCITY_GEOCODER_USER_AGENT=DecibelCity/0.1 (prototipo educativo de reportes de ruido)
# DECIBELCITY_NOMINATIM_MIN_INTERVAL_MS=1000
# DECIBELCITY_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Cloudflare Turnstile (solo POST /api/auth/login) ---------------------------
# Se activa cuando hay clave pública y secreta y ENABLED no es false.
# Claves de prueba oficiales de Cloudflare: sitio 1x00000000000000000000AA, secreto 1x0000000000000000000000000000000AA.
# DECIBELCITY_TURNSTILE_ENABLED=true
# DECIBELCITY_TURNSTILE_SITE_KEY=
# DECIBELCITY_TURNSTILE_SECRET_KEY=

# --- Telegram Bot API (aviso de reportes recibidos) -----------------------------
# Sin token o chat, la notificación es un no-op. Nunca se envían datos de la cuenta.
# DECIBELCITY_TELEGRAM_BOT_TOKEN=
# DECIBELCITY_TELEGRAM_CHAT_ID=

# --- Open-Meteo (clima, sin clave) ----------------------------------------------
# DECIBELCITY_OPEN_METEO_URL=https://api.open-meteo.com
# DECIBELCITY_WEATHER_CACHE_MINUTES=15

# --- Limitación por IP (ventana de 1 minuto) ------------------------------------
# DECIBELCITY_RATE_LIMIT_ENABLED=true
# DECIBELCITY_RATE_LIMIT_LOGIN_PER_MINUTE=5
# DECIBELCITY_RATE_LIMIT_REGISTER_PER_MINUTE=3
# DECIBELCITY_RATE_LIMIT_REPORTS_PER_MINUTE=10
